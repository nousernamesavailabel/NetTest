# Keep this repo scoped to the NetTest project even though it currently lives
# in a home directory.
.*
!.gitignore

# Local environment and dependency installs
venv/
.venv/
env/

# Python runtime artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime output
logs/
results/
*.log
/snapshots/
/packages/

# Vendored offline-install packages and built release bundles
/install-packages/
/linkstate-pkgs/
/requirements/
*.tar.gz

# Local/private configuration
config/config.yaml
config/*.local.yaml

# Secrets and machine-specific SSH/TLS material
.ssh/
*.pem
*.key
id_rsa*
id_ed25519*
/ssl/

# Editor and OS noise
*.swp
*~
.DS_Store

