[Unit]
Description=NetTest Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nettest
Group=nettest
WorkingDirectory=/opt/nettest
ExecStart=/opt/nettest/venv/bin/gunicorn --workers 2 --threads 4 --bind 0.0.0.0:8080 web_dashboard:app
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

